# ---- Credentials and secrets — NEVER commit -------------------------------
.env
*.env
credentials.*
secrets.*
*password*
*.key
*.pem

# ---- Raw / un-redacted evidence -------------------------------------------
# Redact, rename, then commit deliberately.
evidence/raw/
*-raw.png
*-raw.mp4
*-unredacted.*
*-original.png

# ---- Office lock and temp files -------------------------------------------
~$*.xlsx
~$*.docx
.~lock.*#
*.tmp

# ---- OS files -------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---- Local scratch --------------------------------------------------------
scratch/
notes-local.md
*.local.md
